# Copy to .env.local for `vercel dev`. Never commit the filled-in file.
# See docs/SETUP.md.

# From `npm run login`.
GARMIN_TOKEN=

# Shared secret every MCP client must send. Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Optional.
# GARMIN_DOMAIN=garmin.com
# GARMIN_OAUTH_CONSUMER={"consumer_key":"...","consumer_secret":"..."}
# GARMIN_REQUEST_TIMEOUT_MS=20000
# MCP_MAX_RESPONSE_BYTES=350000
